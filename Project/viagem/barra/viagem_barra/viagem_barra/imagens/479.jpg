        slidesToShow: 3,
        slidesToScroll: 1,
        asNavFor: '.slider-top-solo',
        dots: false,
        arrows: true,
        autoplay: true,
        autoplaySpeed: 6000,
        // centerMode: true,
        focusOnSelect: true,
        prevArrow: '<button class="slick-prev slick-arrow" aria-label="Previous" type="button" style=""><i class="bi bi-arrow-right"></i></button>',
